# 页面标题
VITE_APP_TITLE = 智能AI房屋租赁系统

# 生产环境配置
VITE_APP_ENV = 'production'

# 智能AI房屋租赁系统/生产环境
VITE_APP_BASE_API = '/prod-api'

# 生产默认关闭开发账号快捷入口
VITE_DEV_LOGIN = 'false'

# 高德地图 JS API Key。用于户主新建房源时在浏览器端解析地址并写入经纬度。
VITE_AMAP_JS_API_KEY =

# 可选：高德 JS API 安全密钥。控制台开启安全密钥校验时填写。
VITE_AMAP_SECURITY_JS_CODE =

# 是否在打包时开启压缩，支持 gzip 和 brotli
VITE_BUILD_COMPRESS =
