<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiVectorIndexTaskMapper">
    
    <resultMap type="AiVectorIndexTask" id="AiVectorIndexTaskResult">
        <result property="taskId"    column="task_id"    />
        <result property="sourceType"    column="source_type"    />
        <result property="sourceId"    column="source_id"    />
        <result property="action"    column="action"    />
        <result property="status"    column="status"    />
        <result property="retryCount"    column="retry_count"    />
        <result property="errorMsg"    column="error_msg"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectAiVectorIndexTaskVo">
        select task_id, source_type, source_id, action, status, retry_count, error_msg, create_time, update_time from ai_vector_index_task
    </sql>

    <select id="selectAiVectorIndexTaskList" parameterType="AiVectorIndexTask" resultMap="AiVectorIndexTaskResult">
        <include refid="selectAiVectorIndexTaskVo"/>
        <where>  
            <if test="sourceType != null  and sourceType != ''"> and source_type = #{sourceType}</if>
            <if test="sourceId != null "> and source_id = #{sourceId}</if>
            <if test="action != null  and action != ''"> and action = #{action}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="retryCount != null "> and retry_count = #{retryCount}</if>
            <if test="errorMsg != null  and errorMsg != ''"> and error_msg = #{errorMsg}</if>
        </where>
    </select>
    
    <select id="selectAiVectorIndexTaskByTaskId" parameterType="Long" resultMap="AiVectorIndexTaskResult">
        <include refid="selectAiVectorIndexTaskVo"/>
        where task_id = #{taskId}
    </select>

    <insert id="insertAiVectorIndexTask" parameterType="AiVectorIndexTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into ai_vector_index_task
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sourceType != null and sourceType != ''">source_type,</if>
            <if test="sourceId != null">source_id,</if>
            <if test="action != null and action != ''">action,</if>
            <if test="status != null">status,</if>
            <if test="retryCount != null">retry_count,</if>
            <if test="errorMsg != null">error_msg,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sourceType != null and sourceType != ''">#{sourceType},</if>
            <if test="sourceId != null">#{sourceId},</if>
            <if test="action != null and action != ''">#{action},</if>
            <if test="status != null">#{status},</if>
            <if test="retryCount != null">#{retryCount},</if>
            <if test="errorMsg != null">#{errorMsg},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateAiVectorIndexTask" parameterType="AiVectorIndexTask">
        update ai_vector_index_task
        <trim prefix="SET" suffixOverrides=",">
            <if test="sourceType != null and sourceType != ''">source_type = #{sourceType},</if>
            <if test="sourceId != null">source_id = #{sourceId},</if>
            <if test="action != null and action != ''">action = #{action},</if>
            <if test="status != null">status = #{status},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            <if test="errorMsg != null">error_msg = #{errorMsg},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where task_id = #{taskId}
    </update>

    <delete id="deleteAiVectorIndexTaskByTaskId" parameterType="Long">
        delete from ai_vector_index_task where task_id = #{taskId}
    </delete>

    <delete id="deleteAiVectorIndexTaskByTaskIds" parameterType="String">
        delete from ai_vector_index_task where task_id in 
        <foreach item="taskId" collection="array" open="(" separator="," close=")">
            #{taskId}
        </foreach>
    </delete>
</mapper>