<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiConversationMessageMapper">

    <resultMap type="AiConversationMessage" id="AiConversationMessageResult">
        <result property="messageId" column="message_id" />
        <result property="conversationId" column="conversation_id" />
        <result property="userId" column="user_id" />
        <result property="role" column="role" />
        <result property="content" column="content" />
        <result property="intent" column="intent" />
        <result property="intentLabel" column="intent_label" />
        <result property="toolCalls" column="tool_calls" />
        <result property="collaboration" column="collaboration" />
        <result property="contextSnapshot" column="context_snapshot" />
        <result property="createTime" column="create_time" />
    </resultMap>

    <sql id="selectAiConversationMessageVo">
        select message_id, conversation_id, user_id, role, content, intent, intent_label, tool_calls, collaboration, context_snapshot, create_time
        from ai_conversation_message
    </sql>

    <select id="selectAiConversationMessageByMessageId" parameterType="Long" resultMap="AiConversationMessageResult">
        <include refid="selectAiConversationMessageVo"/>
        where message_id = #{messageId}
    </select>

    <select id="selectAiConversationMessageList" parameterType="AiConversationMessage" resultMap="AiConversationMessageResult">
        <include refid="selectAiConversationMessageVo"/>
        <where>
            <if test="conversationId != null"> and conversation_id = #{conversationId}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="role != null and role != ''"> and role = #{role}</if>
        </where>
        order by message_id asc
    </select>

    <insert id="insertAiConversationMessage" parameterType="AiConversationMessage" useGeneratedKeys="true" keyProperty="messageId">
        insert into ai_conversation_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="conversationId != null">conversation_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="role != null">role,</if>
            <if test="content != null">content,</if>
            <if test="intent != null">intent,</if>
            <if test="intentLabel != null">intent_label,</if>
            <if test="toolCalls != null">tool_calls,</if>
            <if test="collaboration != null">collaboration,</if>
            <if test="contextSnapshot != null">context_snapshot,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="conversationId != null">#{conversationId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="role != null">#{role},</if>
            <if test="content != null">#{content},</if>
            <if test="intent != null">#{intent},</if>
            <if test="intentLabel != null">#{intentLabel},</if>
            <if test="toolCalls != null">#{toolCalls},</if>
            <if test="collaboration != null">#{collaboration},</if>
            <if test="contextSnapshot != null">#{contextSnapshot},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <delete id="deleteAiConversationMessageByConversationId" parameterType="Long">
        delete from ai_conversation_message where conversation_id = #{conversationId}
    </delete>
</mapper>
