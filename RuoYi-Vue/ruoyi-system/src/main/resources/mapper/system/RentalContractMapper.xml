<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RentalContractMapper">
    
    <resultMap type="RentalContract" id="RentalContractResult">
        <result property="contractId"    column="contract_id"    />
        <result property="houseId"    column="house_id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="ownerId"    column="owner_id"    />
        <result property="agentId"    column="agent_id"    />
        <result property="contractNo"    column="contract_no"    />
        <result property="startDate"    column="start_date"    />
        <result property="endDate"    column="end_date"    />
        <result property="rentAmount"    column="rent_amount"    />
        <result property="depositAmount"    column="deposit_amount"    />
        <result property="paymentCycle"    column="payment_cycle"    />
        <result property="contractContent"    column="contract_content"    />
        <result property="aiRiskSummary"    column="ai_risk_summary"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRentalContractVo">
        select contract_id, house_id, tenant_id, owner_id, agent_id, contract_no, start_date, end_date, rent_amount, deposit_amount, payment_cycle, contract_content, ai_risk_summary, status, create_time, update_time from rental_contract
    </sql>

    <select id="selectRentalContractList" parameterType="RentalContract" resultMap="RentalContractResult">
        <include refid="selectRentalContractVo"/>
        <where>  
            <if test="houseId != null "> and house_id = #{houseId}</if>
            <if test="tenantId != null "> and tenant_id = #{tenantId}</if>
            <if test="ownerId != null "> and owner_id = #{ownerId}</if>
            <if test="agentId != null "> and agent_id = #{agentId}</if>
            <if test="contractNo != null  and contractNo != ''"> and contract_no = #{contractNo}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="rentAmount != null "> and rent_amount = #{rentAmount}</if>
            <if test="depositAmount != null "> and deposit_amount = #{depositAmount}</if>
            <if test="paymentCycle != null  and paymentCycle != ''"> and payment_cycle = #{paymentCycle}</if>
            <if test="contractContent != null  and contractContent != ''"> and contract_content = #{contractContent}</if>
            <if test="aiRiskSummary != null  and aiRiskSummary != ''"> and ai_risk_summary = #{aiRiskSummary}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectRentalContractByContractId" parameterType="Long" resultMap="RentalContractResult">
        <include refid="selectRentalContractVo"/>
        where contract_id = #{contractId}
    </select>

    <insert id="insertRentalContract" parameterType="RentalContract" useGeneratedKeys="true" keyProperty="contractId">
        insert into rental_contract
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="houseId != null">house_id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="agentId != null">agent_id,</if>
            <if test="contractNo != null and contractNo != ''">contract_no,</if>
            <if test="startDate != null">start_date,</if>
            <if test="endDate != null">end_date,</if>
            <if test="rentAmount != null">rent_amount,</if>
            <if test="depositAmount != null">deposit_amount,</if>
            <if test="paymentCycle != null">payment_cycle,</if>
            <if test="contractContent != null">contract_content,</if>
            <if test="aiRiskSummary != null">ai_risk_summary,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="houseId != null">#{houseId},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="agentId != null">#{agentId},</if>
            <if test="contractNo != null and contractNo != ''">#{contractNo},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="rentAmount != null">#{rentAmount},</if>
            <if test="depositAmount != null">#{depositAmount},</if>
            <if test="paymentCycle != null">#{paymentCycle},</if>
            <if test="contractContent != null">#{contractContent},</if>
            <if test="aiRiskSummary != null">#{aiRiskSummary},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRentalContract" parameterType="RentalContract">
        update rental_contract
        <trim prefix="SET" suffixOverrides=",">
            <if test="houseId != null">house_id = #{houseId},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="agentId != null">agent_id = #{agentId},</if>
            <if test="contractNo != null and contractNo != ''">contract_no = #{contractNo},</if>
            <if test="startDate != null">start_date = #{startDate},</if>
            <if test="endDate != null">end_date = #{endDate},</if>
            <if test="rentAmount != null">rent_amount = #{rentAmount},</if>
            <if test="depositAmount != null">deposit_amount = #{depositAmount},</if>
            <if test="paymentCycle != null">payment_cycle = #{paymentCycle},</if>
            <if test="contractContent != null">contract_content = #{contractContent},</if>
            <if test="aiRiskSummary != null">ai_risk_summary = #{aiRiskSummary},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where contract_id = #{contractId}
    </update>

    <delete id="deleteRentalContractByContractId" parameterType="Long">
        delete from rental_contract where contract_id = #{contractId}
    </delete>

    <delete id="deleteRentalContractByContractIds" parameterType="String">
        delete from rental_contract where contract_id in 
        <foreach item="contractId" collection="array" open="(" separator="," close=")">
            #{contractId}
        </foreach>
    </delete>
</mapper>