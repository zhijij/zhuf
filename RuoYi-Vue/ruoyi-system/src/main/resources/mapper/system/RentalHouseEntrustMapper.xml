    </delete>

    <delete id="deleteRentalHouseEntrustByEntrustIds" parameterType="String">
        delete from rental_house_entrust where entrust_id in 
        <foreach item="entrustId" collection="array" open="(" separator="," close=")">
            #{entrustId}
        </foreach>
    </delete>
