<mapper namespace="com.ruoyi.system.mapper.RentalHouseEntrustMapper">
    
    <resultMap type="RentalHouseEntrust" id="RentalHouseEntrustResult">
        <result property="entrustId"    column="entrust_id"    />
        <result property="houseId"    column="house_id"    />
        <result property="ownerId"    column="owner_id"    />
        <result property="agentId"    column="agent_id"    />
        <result property="entrustScope"    column="entrust_scope"    />
