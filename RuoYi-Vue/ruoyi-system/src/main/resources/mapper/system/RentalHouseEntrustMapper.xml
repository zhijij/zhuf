    <sql id="selectRentalHouseEntrustVo">
        select entrust_id, house_id, owner_id, agent_id, entrust_scope, commission_rate, start_date, end_date, status, create_time, update_time from rental_house_entrust
    </sql>

    <select id="selectRentalHouseEntrustList" parameterType="RentalHouseEntrust" resultMap="RentalHouseEntrustResult">
        <include refid="selectRentalHouseEntrustVo"/>
        <where>  
            <if test="houseId != null "> and house_id = #{houseId}</if>
            <if test="ownerId != null "> and owner_id = #{ownerId}</if>
            <if test="agentId != null "> and agent_id = #{agentId}</if>
            <if test="entrustScope != null  and entrustScope != ''"> and entrust_scope = #{entrustScope}</if>
            <if test="commissionRate != null "> and commission_rate = #{commissionRate}</if>
            <if test="startDate != null "> and start_date = #{startDate}</if>
            <if test="endDate != null "> and end_date = #{endDate}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectRentalHouseEntrustByEntrustId" parameterType="Long" resultMap="RentalHouseEntrustResult">
        <include refid="selectRentalHouseEntrustVo"/>
        where entrust_id = #{entrustId}
    </select>

    <insert id="insertRentalHouseEntrust" parameterType="RentalHouseEntrust" useGeneratedKeys="true" keyProperty="entrustId">
        insert into rental_house_entrust
        <trim prefix="(" suffix=")" suffixOverrides=",">
