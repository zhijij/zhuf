    <update id="updateRentalHouseEntrust" parameterType="RentalHouseEntrust">
        update rental_house_entrust
        <trim prefix="SET" suffixOverrides=",">
            <if test="houseId != null">house_id = #{houseId},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="agentId != null">agent_id = #{agentId},</if>
            <if test="entrustScope != null">entrust_scope = #{entrustScope},</if>
            <if test="commissionRate != null">commission_rate = #{commissionRate},</if>
