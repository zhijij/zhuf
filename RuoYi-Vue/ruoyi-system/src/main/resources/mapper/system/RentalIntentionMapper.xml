<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.RentalIntentionMapper">
    
    <resultMap type="RentalIntention" id="RentalIntentionResult">
        <result property="intentionId"    column="intention_id"    />
        <result property="houseId"    column="house_id"    />
        <result property="tenantId"    column="tenant_id"    />
        <result property="ownerId"    column="owner_id"    />
        <result property="agentId"    column="agent_id"    />
        <result property="intentionLevel"    column="intention_level"    />
        <result property="status"    column="status"    />
        <result property="budgetAmount"    column="budget_amount"    />
        <result property="expectedMoveIn"    column="expected_move_in"    />
        <result property="note"    column="note"    />
        <result property="aiSummary"    column="ai_summary"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRentalIntentionVo">
        select intention_id, house_id, tenant_id, owner_id, agent_id, intention_level, status, budget_amount, expected_move_in, note, ai_summary, create_time, update_time from rental_intention
    </sql>

    <select id="selectRentalIntentionList" parameterType="RentalIntention" resultMap="RentalIntentionResult">
        <include refid="selectRentalIntentionVo"/>
        <where>  
            <if test="houseId != null "> and house_id = #{houseId}</if>
            <if test="tenantId != null "> and tenant_id = #{tenantId}</if>
            <if test="ownerId != null "> and owner_id = #{ownerId}</if>
            <if test="agentId != null "> and agent_id = #{agentId}</if>
            <if test="intentionLevel != null  and intentionLevel != ''"> and intention_level = #{intentionLevel}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="budgetAmount != null "> and budget_amount = #{budgetAmount}</if>
            <if test="expectedMoveIn != null "> and expected_move_in = #{expectedMoveIn}</if>
            <if test="note != null  and note != ''"> and note = #{note}</if>
            <if test="aiSummary != null  and aiSummary != ''"> and ai_summary = #{aiSummary}</if>
        </where>
    </select>
    
    <select id="selectRentalIntentionByIntentionId" parameterType="Long" resultMap="RentalIntentionResult">
        <include refid="selectRentalIntentionVo"/>
        where intention_id = #{intentionId}
    </select>

    <insert id="insertRentalIntention" parameterType="RentalIntention" useGeneratedKeys="true" keyProperty="intentionId">
        insert into rental_intention
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="houseId != null">house_id,</if>
            <if test="tenantId != null">tenant_id,</if>
            <if test="ownerId != null">owner_id,</if>
            <if test="agentId != null">agent_id,</if>
            <if test="intentionLevel != null">intention_level,</if>
            <if test="status != null">status,</if>
            <if test="budgetAmount != null">budget_amount,</if>
            <if test="expectedMoveIn != null">expected_move_in,</if>
            <if test="note != null">note,</if>
            <if test="aiSummary != null">ai_summary,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="houseId != null">#{houseId},</if>
            <if test="tenantId != null">#{tenantId},</if>
            <if test="ownerId != null">#{ownerId},</if>
            <if test="agentId != null">#{agentId},</if>
            <if test="intentionLevel != null">#{intentionLevel},</if>
            <if test="status != null">#{status},</if>
            <if test="budgetAmount != null">#{budgetAmount},</if>
            <if test="expectedMoveIn != null">#{expectedMoveIn},</if>
            <if test="note != null">#{note},</if>
            <if test="aiSummary != null">#{aiSummary},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRentalIntention" parameterType="RentalIntention">
        update rental_intention
        <trim prefix="SET" suffixOverrides=",">
            <if test="houseId != null">house_id = #{houseId},</if>
            <if test="tenantId != null">tenant_id = #{tenantId},</if>
            <if test="ownerId != null">owner_id = #{ownerId},</if>
            <if test="agentId != null">agent_id = #{agentId},</if>
            <if test="intentionLevel != null">intention_level = #{intentionLevel},</if>
            <if test="status != null">status = #{status},</if>
            <if test="budgetAmount != null">budget_amount = #{budgetAmount},</if>
            <if test="expectedMoveIn != null">expected_move_in = #{expectedMoveIn},</if>
            <if test="note != null">note = #{note},</if>
            <if test="aiSummary != null">ai_summary = #{aiSummary},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where intention_id = #{intentionId}
    </update>

    <delete id="deleteRentalIntentionByIntentionId" parameterType="Long">
        delete from rental_intention where intention_id = #{intentionId}
    </delete>

    <delete id="deleteRentalIntentionByIntentionIds" parameterType="String">
        delete from rental_intention where intention_id in 
        <foreach item="intentionId" collection="array" open="(" separator="," close=")">
            #{intentionId}
        </foreach>
    </delete>
</mapper>