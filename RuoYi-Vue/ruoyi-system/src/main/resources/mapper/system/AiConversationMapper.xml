<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.AiConversationMapper">

    <resultMap type="AiConversation" id="AiConversationResult">
        <result property="conversationId" column="conversation_id" />
        <result property="userId" column="user_id" />
        <result property="title" column="title" />
        <result property="role" column="role" />
        <result property="workMode" column="work_mode" />
        <result property="summary" column="summary" />
        <result property="lastMessage" column="last_message" />
        <result property="lastMessageTime" column="last_message_time" />
        <result property="status" column="status" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectAiConversationVo">
        select conversation_id, user_id, title, role, work_mode, summary, last_message, last_message_time, status, create_time, update_time
        from ai_conversation
    </sql>

    <select id="selectAiConversationByConversationId" parameterType="Long" resultMap="AiConversationResult">
        <include refid="selectAiConversationVo"/>
        where conversation_id = #{conversationId}
    </select>

    <select id="selectAiConversationList" parameterType="AiConversation" resultMap="AiConversationResult">
        <include refid="selectAiConversationVo"/>
        <where>
            <if test="conversationId != null"> and conversation_id = #{conversationId}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="role != null and role != ''"> and role = #{role}</if>
            <if test="workMode != null and workMode != ''"> and work_mode = #{workMode}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by last_message_time desc, update_time desc, conversation_id desc
    </select>

    <insert id="insertAiConversation" parameterType="AiConversation" useGeneratedKeys="true" keyProperty="conversationId">
        insert into ai_conversation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="title != null">title,</if>
            <if test="role != null">role,</if>
            <if test="workMode != null">work_mode,</if>
            <if test="summary != null">summary,</if>
            <if test="lastMessage != null">last_message,</if>
            <if test="lastMessageTime != null">last_message_time,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="title != null">#{title},</if>
            <if test="role != null">#{role},</if>
            <if test="workMode != null">#{workMode},</if>
            <if test="summary != null">#{summary},</if>
            <if test="lastMessage != null">#{lastMessage},</if>
            <if test="lastMessageTime != null">#{lastMessageTime},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateAiConversation" parameterType="AiConversation">
        update ai_conversation
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null">title = #{title},</if>
            <if test="role != null">role = #{role},</if>
            <if test="workMode != null">work_mode = #{workMode},</if>
            <if test="summary != null">summary = #{summary},</if>
            <if test="lastMessage != null">last_message = #{lastMessage},</if>
            <if test="lastMessageTime != null">last_message_time = #{lastMessageTime},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where conversation_id = #{conversationId}
    </update>
</mapper>
