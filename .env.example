MYSQL_DATABASE=ry-vue
MYSQL_USER=ruoyi
MYSQL_PASSWORD=feng123
REDIS_PASSWORD=2972515097Fzh/
PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple

# 可选：接入 OpenAI-compatible 大模型。不配置时 AI 服务会使用本地规则工具链，业务功能仍可用。
# OpenAI 示例：
# AI_LLM_BASE_URL=https://api.openai.com/v1
# AI_LLM_API_KEY=sk-...
# AI_LLM_MODEL=gpt-4.1-mini
# 千问 / 阿里云百炼示例（北京地域）：
# AI_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_LLM_API_KEY=sk-...
# AI_LLM_MODEL=qwen-plus
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=

# pgvector 向量库。用于 AI 房源知识库持久化存储。
VECTOR_DB_NAME=smart_rental_ai
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=postgres
VECTOR_DB_PORT=5433
VECTOR_DB_EMBEDDING_DIM=64

# 可选：接入 OpenAI-compatible embeddings。未配置时会回退到本地哈希向量。
# OpenAI 示例：
# AI_EMBEDDING_BASE_URL=https://api.openai.com/v1
# AI_EMBEDDING_API_KEY=sk-...
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AI_EMBEDDING_DIM=1536
# 千问 / 阿里云百炼文本向量示例（北京地域）：
# AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_EMBEDDING_API_KEY=sk-...
# AI_EMBEDDING_MODEL=text-embedding-v4
# AI_EMBEDDING_DIM=1024
# 注意：VECTOR_DB_EMBEDDING_DIM 需要和 AI_EMBEDDING_DIM 保持一致。
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIM=

# 可选：对象存储。默认 local，生产可切换为 tencent-cos。
# 注意：SecretId / SecretKey 只能写本机 .env 或服务器环境变量，不要提交到 Git。
STORAGE_PROVIDER=local
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-chengdu
TENCENT_COS_BUCKET=document-1419823100
TENCENT_COS_PRESIGNED_EXPIRATION_SECONDS=43200
